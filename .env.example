PORT=3000

# For production, set this to a long random string.
JWT_SECRET=dev-insecure-secret-change-me

# Postgres connection parts (app constructs the connection URL).
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_PROD_DB=example_prod
POSTGRES_TEST_DB=example_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# CORS
CORS_ORIGIN=*

